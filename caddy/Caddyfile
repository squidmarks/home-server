# Name-based routing for everything on the tailnet. Wildcard certificates
# (DNS challenge through Cloudflare): one for the domain and its tools
# (ha., llm., grafana., ...), one for the studios under studio.<domain>.
{
	# Tailnet only: never listen on the LAN or anywhere else.
	default_bind {$TAILNET_IP}
}

{$DOMAIN}, *.{$DOMAIN} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# The home page: links to everything.
	@home host {$DOMAIN}
	handle @home {
		reverse_proxy 127.0.0.1:3090
	}

	# --- Home Assistant (a VM on this box, reached over the tailnet) ------
	@ha host ha.{$DOMAIN}
	handle @ha {
		reverse_proxy {$HA_UPSTREAM} {
			# HA rejects forwarded requests from proxies it hasn't been told to
			# trust; without the header it just sees this box's tailnet IP.
			header_up -X-Forwarded-For
		}
	}

	# --- The inference box -------------------------------------------------
	@llm host llm.{$DOMAIN}
	handle @llm {
		redir / /admin/
		reverse_proxy http://{$INFERENCE_FQDN}:8091
	}
	@grafana host grafana.{$DOMAIN}
	handle @grafana {
		reverse_proxy https://{$INFERENCE_FQDN}:3300 {
			header_up Host {upstream_hostport}
		}
	}
	@bench host bench.{$DOMAIN}
	handle @bench {
		reverse_proxy https://{$INFERENCE_FQDN}:3400 {
			header_up Host {upstream_hostport}
		}
	}
	@mongo host mongo.{$DOMAIN}
	handle @mongo {
		reverse_proxy https://{$INFERENCE_FQDN}:3600 {
			header_up Host {upstream_hostport}
		}
	}

	handle {
		respond "Unknown service" 404
	}
}

# --- Agent studios: <name>.studio.<domain> (one shared agent-service) -------
# Their own level, so a shared login cookie can cover .studio.<domain> without
# reaching the tools above.
*.studio.{$DOMAIN} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	@api host api.studio.{$DOMAIN}
	handle @api {
		reverse_proxy 127.0.0.1:3001
	}
	@home host home.studio.{$DOMAIN}
	handle @home {
		reverse_proxy 127.0.0.1:3702
	}
	@witness host witness.studio.{$DOMAIN}
	handle @witness {
		# oauth2-proxy (Google login) in front of the Witness web app.
		reverse_proxy 127.0.0.1:4180
	}
	@connect host connect.studio.{$DOMAIN}
	handle @connect {
		# Witness's Gmail/Drive connection callback.
		reverse_proxy 127.0.0.1:8085
	}
	@invest host invest.studio.{$DOMAIN}
	handle @invest {
		reverse_proxy 127.0.0.1:3704
	}

	handle {
		respond "Unknown studio" 404
	}
}
