# Name-based routing for everything on the tailnet. Every app except Home
# Assistant (own login, app and webhooks), the hot tub's guest page and the
# inference API is behind the single sign-on `gate` (access/). Wildcard certificates
# (DNS challenge through Cloudflare): one for the domain and its tools
# (ha., llm., grafana., ...), one for the studios under studio.<domain>.
{
	# Tailnet only: never listen on the LAN or anywhere else.
	default_bind {$TAILNET_IP}
}

# --- Single sign-on gate (access/) -----------------------------------------
# `import gate <app-id> <upstream>`: Google sign-in via the sso proxy (one
# cookie for the whole domain), then the access service decides whether that
# email may use <app-id> (rules on access.<domain>). Non-2xx answers from either
# go back to the browser: 401 -> sign in, 403 -> a "no access" page.
(gate) {
	route {
		# Only the sso proxy may say who the viewer is.
		request_header -X-Auth-Request-Email
		forward_auth 127.0.0.1:4182 {
			uri /oauth2/auth
			header_up X-Real-IP {remote_host}
			copy_headers X-Auth-Request-Email
			@unauthorized status 401
			handle_response @unauthorized {
				redir * https://auth.{$DOMAIN}/oauth2/start?rd={scheme}://{host}{uri}
			}
		}
		forward_auth 127.0.0.1:3600 {
			uri /authz
			header_up X-Access-App {args[0]}
		}
		reverse_proxy {args[1]}
	}
}

# Same, for upstreams that stream (server-sent events): never buffer.
(gate_stream) {
	route {
		request_header -X-Auth-Request-Email
		forward_auth 127.0.0.1:4182 {
			uri /oauth2/auth
			header_up X-Real-IP {remote_host}
			copy_headers X-Auth-Request-Email
			@unauthorized status 401
			handle_response @unauthorized {
				redir * https://auth.{$DOMAIN}/oauth2/start?rd={scheme}://{host}{uri}
			}
		}
		forward_auth 127.0.0.1:3600 {
			uri /authz
			header_up X-Access-App {args[0]}
		}
		reverse_proxy {args[1]} {
			flush_interval -1
		}
	}
}

# --- The hot tub: hottub.<domain>, on the tailnet AND the LAN ---------------
# The one name that also listens on the LAN IP (LAN_IP in caddy/.env), so
# guests on the home Wi-Fi reach it without Tailscale; its DNS record points
# at the LAN IP and tailnet devices away from home use home's subnet route.
# Anyone who reaches it can use the guest controls; /admin and /api/admin/*
# go through the single sign-on gate (rule "hottub-admin" on access.<domain>).
hottub.{$DOMAIN} {
	bind {$TAILNET_IP} {$LAN_IP}
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# Admin pages: single sign-on, rule "hottub-admin" on access.<domain>.
	@admin path /admin /admin/* /admin.html /admin.js /api/admin/*
	handle @admin {
		import gate hottub-admin 127.0.0.1:3500
	}

	handle {
		request_header -X-Auth-Request-Email
		reverse_proxy 127.0.0.1:3500 {
			# Live updates (server-sent events) must not be buffered.
			flush_interval -1
		}
	}
}

{$DOMAIN}, *.{$DOMAIN} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# The home page: links to everything.
	@home host {$DOMAIN}
	handle @home {
		import gate home 127.0.0.1:3090
	}

	# --- Single sign-on: Google sign-in for every gated app, and the access
	#     admin page (who may use which app). See access/.
	@auth host auth.{$DOMAIN}
	handle @auth {
		handle /oauth2/* {
			reverse_proxy 127.0.0.1:4182 {
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-Uri {uri}
			}
		}
		# Where sign-out lands. Deliberately not gated: landing on a gated page
		# would send you straight back through Google and sign you in again.
		handle /signed-out {
			header Content-Type "text/html; charset=utf-8"
			header Cache-Control no-store
			respond `<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Signed out</title><style>body{font:16px/1.5 system-ui,sans-serif;margin:0;display:grid;place-items:center;min-height:100vh;background:#f3f6f7;color:#0f2530}main{max-width:26em;padding:24px;text-align:center}h1{font-size:22px;margin:0 0 8px}p{color:#5b6f78}a{display:inline-block;margin-top:8px;background:#0e8fb0;color:#fff;text-decoration:none;font-weight:600;padding:10px 18px;border-radius:10px}@media(prefers-color-scheme:dark){body{background:#0b1d26;color:#e8f2f5}p{color:#93adb7}}</style></head><body><main><h1>You're signed out</h1><p>Signed out of every app on this domain.</p><a href="https://{$DOMAIN}/">Sign in again</a></main></body></html>` 200
		}
		handle {
			redir https://{$DOMAIN}/
		}
	}
	@access host access.{$DOMAIN}
	handle @access {
		import gate access 127.0.0.1:3600
	}

	# --- Home Assistant (a VM on this box, reached over the tailnet) ------
	@ha host ha.{$DOMAIN}
	handle @ha {
		reverse_proxy {$HA_UPSTREAM} {
			# HA rejects forwarded requests from proxies it hasn't been told to
			# trust; without the header it just sees this box's tailnet IP.
			header_up -X-Forwarded-For
		}
	}

	# --- The inference box -------------------------------------------------
	@llm host llm.{$DOMAIN}
	handle @llm {
		redir / /admin/
		# The config page is gated; the API (/v1, /health, ...) stays open to the
		# tailnet as before: programs (Claude desktop's gateway, Claude Code) can't
		# do a browser sign-in.
		@llm_admin path /admin /admin/*
		handle @llm_admin {
			import gate llm http://{$INFERENCE_FQDN}:8091
		}
		handle {
			reverse_proxy http://{$INFERENCE_FQDN}:8091
		}
	}

	# --- Monitoring and data (on this box) ---------------------------------
	@grafana host grafana.{$DOMAIN}
	handle @grafana {
		import gate grafana 127.0.0.1:3000
	}
	@mongo host mongo.{$DOMAIN}
	handle @mongo {
		import gate mongo 127.0.0.1:3110
	}
	@dogs host dogs.{$DOMAIN}
	handle @dogs {
		# /api/stream is server-sent events: the streaming gate never buffers.
		import gate_stream dogs 127.0.0.1:3800
	}
	@bench host bench.{$DOMAIN}
	handle @bench {
		import gate bench 127.0.0.1:3400
	}

	handle {
		respond "Unknown service" 404
	}
}

# --- Agent studios: <name>.studio.<domain> (one shared agent-service) -------
# Each studio web app is behind the domain's single sign-on (the `gate`
# snippet: sso proxy on 127.0.0.1:4182, rules on access.<domain>). The web apps
# read who is signed in from /oauth2/userinfo on their own host.

# A studio web app behind the single sign-on. {args[0]} is its upstream,
# {args[1]} its rule on access.<domain>.
(studio) {
	# Agent webhooks carry the agent's own whsec_ secret, which the
	# agent-service checks; callers like Home Assistant can't sign in.
	@webhook {
		path /agents/*
		header Authorization "Bearer whsec_*"
	}
	@webhook_query {
		path /agents/*
		expression {query.token}.startsWith("whsec_")
	}
	handle @webhook {
		reverse_proxy {args[0]}
	}
	handle @webhook_query {
		reverse_proxy {args[0]}
	}

	# Sign out. Behind the proxy the studio's NextAuth session isn't the real
	# login, so its signOut() (POST /api/auth/signout, then go to the "url" in
	# the JSON reply) is answered here: clear the sso cookie, land signed out.
	@signout {
		method POST
		path /api/auth/signout
	}
	handle @signout {
		header Content-Type application/json
		respond `{"url":"https://auth.{$DOMAIN}/oauth2/sign_out?rd=https%3A%2F%2Fauth.{$DOMAIN}%2Fsigned-out"}` 200
	}

	# The sso proxy's own endpoints on the studio's host: the web apps read
	# who is signed in from /oauth2/userinfo (the cookie covers .<domain>).
	handle /oauth2/* {
		reverse_proxy 127.0.0.1:4182 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Uri {uri}
		}
	}

	# Everything else: single sign-on, rule {args[1]} on access.<domain>. The
	# gate also passes the verified email (X-Auth-Request-Email) to the studio's
	# server-side routes (AUTH_PROXY_EMAIL_HEADER), after dropping any copy the
	# browser sent.
	handle {
		import gate {args[1]} {args[0]}
	}
}

*.studio.{$DOMAIN} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	@home host home.studio.{$DOMAIN}
	handle @home {
		import studio 127.0.0.1:3702 home-studio
	}
	@witness host witness.studio.{$DOMAIN}
	handle @witness {
		import studio 127.0.0.1:3703 witness-studio
	}

	# The shared agent-service: the studio web apps call it from the browser
	# (Socket.IO and REST), so it isn't behind the login page; it serves only
	# the tailnet, and agent webhooks are checked against their own secret.
	@api host api.studio.{$DOMAIN}
	handle @api {
		reverse_proxy 127.0.0.1:3001
	}
	# Witness's Gmail/Drive connection callback: Google redirects the browser
	# here mid-flow, so it can't sit behind the login either.
	@connect host connect.studio.{$DOMAIN}
	handle @connect {
		reverse_proxy 127.0.0.1:8085
	}

	handle {
		respond "Unknown studio" 404
	}
}
